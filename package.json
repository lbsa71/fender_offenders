{
  "name": "fender-offenders",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx tools/dev.ts",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "check": "tsc --noEmit && tsx tools/check.ts",
    "prepare": "node tools/install-hooks.mjs",
    "hooks:install": "node tools/install-hooks.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test && pnpm test:e2e:ui && pnpm test:water && pnpm test:audio && pnpm test:helicopter",
    "test:audio": "node packages/renderer/dev/check-patrol-audio.mjs && node packages/renderer/dev/render-patrol-audio.mjs",
    "test:e2e:ui": "pnpm test:ui",
    "test:load": "tsx tools/load.ts",
    "test:deploy": "tsx tools/deploy-smoke.ts",
    "assets:check": "tsx tools/assets/check.ts",
    "build": "vite build && esbuild apps/server/src/index.ts --bundle --platform=node --format=esm --external:@colyseus/* --external:@dimforge/* --external:express --outfile=dist/server/index.js",
    "start": "tsx apps/server/src/index.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:ui": "node packages/ui/dev/garage-smoke.mjs && node packages/ui/dev/pursuit-smoke.mjs && node packages/ui/dev/campaign-smoke.mjs && node packages/ui/dev/callsigns-smoke.mjs && node packages/ui/dev/briefing-smoke.mjs",
    "test:water": "tsx packages/renderer/scenarios/water-visibility-check.ts && tsx packages/renderer/scenarios/water-finish-check.ts && tsx packages/renderer/scenarios/water-splash-check.ts",
    "test:helicopter": "tsx packages/renderer/scenarios/helicopter-check.ts"
  },
  "dependencies": {
    "@fender/contracts": "workspace:*",
    "@fender/content": "workspace:*",
    "@fender/sim": "workspace:*",
    "@fender/physics": "workspace:*",
    "@fender/input": "workspace:*",
    "@fender/ui": "workspace:*",
    "@fender/renderer": "workspace:*",
    "@fender/net-client": "workspace:*",
    "@fender/net-server": "workspace:*",
    "@babylonjs/core": "9.32.0",
    "@dimforge/rapier3d-compat": "0.21.0",
    "@colyseus/sdk": "0.18.6",
    "@colyseus/ws-transport": "0.18.4",
    "express": "5.2.1",
    "@colyseus/core": "0.18.23"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/express": "^5.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "tsx": "4.23.15",
    "@playwright/test": "1.64.1",
    "esbuild": "^0.27.0"
  }
}
